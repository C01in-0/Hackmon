# 复制为 .env 后替换所有示例值；.env 不会进入 Git 或 Docker 构建上下文。
T1_MODE=live
T1_AUTH_MODE=ctfd
T1_REQUIRE_ENTRY_CODE=1
T1_DEV_MODE=0
T1_UNLIMITED_DAILY=1

T1_CTFD_ORIGIN=https://ctfd.example.org
T1_PUBLIC_ORIGIN=https://hackmon.example.org
T1_COOKIE_SECURE=1
# 反向代理与后端共用的独立随机值；不经过代理时留空。
T1_PROXY_TOKEN=
T1_ADMIN_TOKEN=replace_with_a_long_random_admin_token

T1_MODEL_PROVIDER=aliyun
T1_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
T1_MODEL_API_KEY=
T1_MODEL=qwen3.5-flash
T1_TEST_REWARD=AHUCTF{replace_with_your_static_flag}

HOST=127.0.0.1
PORT=3000
# Compose 会覆盖容器内的 HOST，并用此 PORT 决定本机映射端口。
# 可选：T1_BASE_PATH=/hackmon
# 可选：T1_MODEL_TIMEOUT_MS=40000
# 可选：T1_MODEL_MAX_TOKENS=512
# 可选：T1_MODEL_RETRIES=0
# 可选：T1_GLOBAL_CALL_LIMIT=0（0 表示不限）
# 可选：T1_BUDGET_CNY=0（0 表示不限）
# 可选：T1_TEST_USER_IDS=1,2（这些 CTFd 用户不进入真人对战池）
